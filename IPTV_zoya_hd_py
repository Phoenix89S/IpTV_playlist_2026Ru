def utc_now():
    return datetime.now(timezone.utc).isoformat(timespec='seconds').replace('+00:00', 'Z')


def next_playlist_path(requested):
    """Never overwrite a previous merge_auto playlist.
    merge_auto.m3u -> merge_auto_1.m3u -> merge_auto_2.m3u ...
    If an explicit non-default path is supplied, preserve its stem and still
    use the same collision-safe suffixing rule.
    """
    path = Path(requested)
    if not path.exists():
        return path
    stem, suffix = path.stem, path.suffix or '.m3u'
    n = 1
    while True:
        candidate = path.with_name(f'{stem}_{n}{suffix}')
        if not candidate.exists():
            return candidate
        n += 1


def init_db(db_path):
    con = sqlite3.connect(db_path)
    con.execute("""
        CREATE TABLE IF NOT EXISTS runs (
            run_id INTEGER PRIMARY KEY AUTOINCREMENT,
            started_utc TEXT NOT NULL,
            playlist_source TEXT,
            output_playlist TEXT,
            channels INTEGER DEFAULT 0,
            original_alive INTEGER DEFAULT 0,
            original_dead INTEGER DEFAULT 0,
            recovered INTEGER DEFAULT 0,
            candidate_count INTEGER DEFAULT 0,
            verified_count INTEGER DEFAULT 0
        )
    """)
    con.execute("""
        CREATE TABLE IF NOT EXISTS candidates (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            channel_key TEXT NOT NULL,
            tvg_id TEXT,
            channel_name TEXT,
            url TEXT NOT NULL,
            source TEXT,
            status TEXT,
            first_seen_utc TEXT NOT NULL,
            last_seen_utc TEXT NOT NULL,
            first_run_id INTEGER,
            last_run_id INTEGER,
            times_seen INTEGER NOT NULL DEFAULT 1,
            times_verified INTEGER NOT NULL DEFAULT 0,
            UNIQUE(channel_key, url)
        )
    """)
    con.execute("""
        CREATE TABLE IF NOT EXISTS candidate_runs (
            run_id INTEGER NOT NULL,
            candidate_id INTEGER NOT NULL,
            status TEXT,
            source TEXT,
            observed_utc TEXT NOT NULL,
            PRIMARY KEY(run_id, candidate_id)
        )
    """)
    con.execute("CREATE INDEX IF NOT EXISTS idx_candidates_channel ON candidates(channel_key)")
    con.execute("CREATE INDEX IF NOT EXISTS idx_candidates_status ON candidates(status)")
    con.commit()
    return con


def db_start_run(con, playlist_source, output_playlist):
    cur = con.execute(
        "INSERT INTO runs(started_utc, playlist_source, output_playlist) VALUES(?,?,?)",
        (utc_now(), str(playlist_source), str(output_playlist))
    )
    con.commit()
    return cur.lastrowid


def db_record_candidate(con, run_id, ch, url, source, status):
    now = utc_now()
    channel_key = ch.get('tvg_id') or ch.get('name') or 'unknown'
    con.execute("""
        INSERT INTO candidates(
            channel_key,tvg_id,channel_name,url,source,status,
            first_seen_utc,last_seen_utc,first_run_id,last_run_id,
            times_seen,times_verified
        ) VALUES(?,?,?,?,?,?,?,?,?,?,1,?)
        ON CONFLICT(channel_key,url) DO UPDATE SET
            source=excluded.source,
            status=excluded.status,
            last_seen_utc=excluded.last_seen_utc,
            last_run_id=excluded.last_run_id,
            times_seen=candidates.times_seen+1,
            times_verified=candidates.times_verified+excluded.times_verified
    """, (
        channel_key, ch.get('tvg_id',''), ch.get('name',''), url, source, status,
        now, now, run_id, run_id, 1 if status == 'VERIFIED' else 0
    ))
    row = con.execute(
        "SELECT id FROM candidates WHERE channel_key=? AND url=?",
        (channel_key, url)
    ).fetchone()
    candidate_id = row[0]
    con.execute("""
        INSERT OR REPLACE INTO candidate_runs(run_id,candidate_id,status,source,observed_utc)
        VALUES(?,?,?,?,?)
    """, (run_id, candidate_id, status, source, now))
    return candidate_id


def db_finish_run(con, run_id, channels, original_alive, original_dead,
                  recovered, candidate_count, verified_count):
    con.execute("""
        UPDATE runs SET channels=?, original_alive=?, original_dead=?,
                       recovered=?, candidate_count=?, verified_count=?
        WHERE run_id=?
    """, (channels, original_alive, original_dead, recovered,
          candidate_count, verified_count, run_id))
    con.commit()


def append_json_history(json_path, payload):
    path = Path(json_path)
    history = []
    if path.exists():
        try:
            old = json.loads(path.read_text('utf-8'))
            if isinstance(old, list):
                history = old
            elif isinstance(old, dict) and isinstance(old.get('runs'), list):
                history = old['runs']
        except Exception:
            # Preserve a damaged/foreign JSON file instead of destroying it.
            backup = path.with_suffix(path.suffix + '.broken')
            if not backup.exists():
                path.replace(backup)
    history.append(payload)
    path.write_text(
        json.dumps(history, ensure_ascii=False, indent=2),
        encoding='utf-8'
    )


def append_report(report_path, lines):
